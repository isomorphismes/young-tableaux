"""Execute checked RSK domains against the existing native mathematical owner."""
import argparse
import hashlib
import shutil
import subprocess
from pathlib import Path
from builtins import SystemExit, sorted

ROOT ∈ object ← Path(__file__).resolve().parent.parent

def execute(idric ∈ str, environment ∈ str, directory ∈ object, module ∈ str) → object:
    if directory.exists():
        shutil.rmtree(directory)
    directory.joinpath("YoungTableaux").mkdir(parents=True)
    directory.joinpath("YoungTableaux/CheckedRSK.idric").write_text(module)
    driver ∈ object ← directory.joinpath("RSKChecks.idric")
    shutil.copyfile(ROOT.joinpath("examples/autogenerated/checked-rsk/RSKChecks.idric"), driver)
    result ∈ object ← subprocess.run([idric, "-o", "rsk-checks", "RSKChecks.idric"],
        cwd=directory, text=True, capture_output=True, timeout=120)
    directory.joinpath("compile.stdout").write_text(result.stdout)
    directory.joinpath("compile.stderr").write_text(result.stderr)
    executable ∈ object ← directory.joinpath("build/exec/rsk-checks")
    code ∈ int ← result.returncode
    stdout ∈ str ← result.stdout
    stderr ∈ str ← result.stderr
    exists ∈ bool ← executable.is_file()
    if code != 0 or not exists or "Error:" in stdout or "Error:" in stderr:
        raise SystemExit("FAIL: actual Idriç compilation; see " + str(directory))
    result = subprocess.run([environment, str(executable)], cwd=directory,
        text=True, capture_output=True, timeout=60)
    directory.joinpath("execution.stdout").write_text(result.stdout)
    directory.joinpath("execution.stderr").write_text(result.stderr)
    return result

def main() → None:
    parser ∈ object ← argparse.ArgumentParser()
    parser.add_argument("--compiler", required=True)
    parser.add_argument("--idric", required=True)
    parser.add_argument("--idric-env", required=True)
    args ∈ object ← parser.parse_args()
    compiler ∈ str ← args.compiler
    idric ∈ str ← args.idric
    environment ∈ str ← args.idric_env
    output ∈ object ← ROOT.joinpath("build/typed-rsk-evidence")
    if output.exists():
        shutil.rmtree(output)
    output.mkdir(parents=True)
    module ∈ str ← ROOT.joinpath("types/YoungTableaux/CheckedRSK.idric").read_text()
    result ∈ object ← execute(idric, environment, output.joinpath("actual"), module)
    code ∈ int ← result.returncode
    observed ∈ str ← result.stdout
    if code != 0 or "ADMISSION_FAILURE" in observed:
        raise SystemExit("FAIL: actual checked RSK execution; see " + str(output))
    native ∈ object ← output.joinpath("native-observer")
    command ∈ list[str] ← [compiler,"-fno-link-libatomic","-std=c17","-O2","-Wall","-Wextra",
        "-Werror","-Wpedantic","-Wshadow","-I" + str(ROOT.joinpath("app/core")),
        str(ROOT.joinpath("tests/typed_rsk_observer.c"))]
    paths ∈ list[object] ← sorted(ROOT.joinpath("app/core").glob("*.c"))
    for path in paths:
        command.append(str(path))
    command.extend(["-lm","-o",str(native)])
    subprocess.run(command,check=True,timeout=120)
    result = subprocess.run([str(native)],text=True,capture_output=True,timeout=60)
    output.joinpath("native.stdout").write_text(result.stdout)
    output.joinpath("native.stderr").write_text(result.stderr)
    code = result.returncode
    expected ∈ str ← result.stdout
    observations ∈ int ← expected.count("S=")
    if code != 0 or observations != 2041 or observed != expected:
        raise SystemExit("FAIL: executed Idriç/native RSK traces differ; see " + str(output))
    receipts ∈ list[str] ← ["case\tresult\n","native-prefix-observations-" + str(observations) + "\tPASS\n"]
    type_controls ∈ list[tuple[str,str]] ← [("RejectWordInverse","WordPair"),
        ("RejectForgedWord","AdmittedWord"),("RejectPrefixInverse","RSKPrefix")]
    actual ∈ object ← output.joinpath("actual")
    for control in type_controls:
        name ∈ str ← control[0]
        diagnostic ∈ str ← control[1]
        shutil.copyfile(ROOT.joinpath("examples/autogenerated/checked-rsk",name + ".idric"),
            actual.joinpath(name + ".idric"))
        result = subprocess.run([idric,"--check",name + ".idric"],cwd=actual,
            text=True,capture_output=True,timeout=120)
        stdout ∈ str ← result.stdout
        stderr ∈ str ← result.stderr
        actual.joinpath(name + ".stdout").write_text(stdout)
        actual.joinpath(name + ".stderr").write_text(stderr)
        if not ("Error:" in stdout) or not (diagnostic in stdout):
            raise SystemExit("FAIL: Idriç type boundary accepted: " + name)
        receipts.append(name + "\tREJECTED\n")
    mutations ∈ list[tuple[str,str,str,str]] ← [
        ("bump-equal","if first > value then","if first >= value then",""),
        ("entry-overflow","value > 0 && value <= 2147483647","value > 0","ADMISSION_FAILURE entry-overflow"),
        ("permutation-alphabet","&& sort letters ≟ map cast (one_through (length letters))","&& True","ADMISSION_FAILURE repeated-permutation"),
        ("biword-order","&& letters_ordered letters","&& True","ADMISSION_FAILURE biword-order"),
        ("matrix-expansion-limit","&& sum (concat (first :: rest)) <= 64","&& True","ADMISSION_FAILURE matrix-overflow"),
        ("pair-shape","map length insertion.rows ≟ map length recording.rows","True","ADMISSION_FAILURE pair-shape"),
        ("partial-word","if not (prefix.processed ≟ prefix.input_count) then Nothing else do","if False then Nothing else do","ADMISSION_FAILURE partial-word"),
        ("inverse-order","(outgoing :: values)","(values ++ [outgoing])","ADMISSION_FAILURE inverse-roundtrip")]
    for mutation in mutations:
        name ∈ str ← mutation[0]
        old ∈ str ← mutation[1]
        new ∈ str ← mutation[2]
        diagnostic ∈ str ← mutation[3]
        count ∈ int ← module.count(old)
        if count != 1:
            raise SystemExit("FAIL: nonunique RSK mutation: " + name)
        result = execute(idric,environment,output.joinpath(name),module.replace(old,new))
        code = result.returncode
        observed = result.stdout
        if name == "bump-equal":
            if code == 0 or not ("UNEXPECTED_REJECTION" in observed):
                raise SystemExit("FAIL: equal-bump mutant escaped")
        else:
            if code == 0 or not (diagnostic in observed):
                raise SystemExit("FAIL: RSK admission mutant escaped: " + name)
        receipts.append(name + "\tREJECTED\n")
    output.joinpath("receipt.tsv").write_text("".join(receipts))
    digest ∈ str ← hashlib.sha256(expected.encode()).hexdigest()
    output.joinpath("observations.sha256").write_text(digest + "\n")
    print("IDRIC_RSK PASS: " + str(observations) + " native prefix observations, 155 permutation roundtrips, 3 rejected type controls, 8 compiled rejecting mutants")

main()
