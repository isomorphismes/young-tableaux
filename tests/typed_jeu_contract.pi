"""Compile actual Idriç transitions and compare their executed traces with native C."""
import argparse
import hashlib
import shutil
import subprocess
from pathlib import Path
from builtins import SystemExit, sorted

ROOT ∈ object ← Path(__file__).resolve().parent.parent

def compile_and_run(idric ∈ str, environment ∈ str, directory ∈ object,
                    module ∈ str, model_name ∈ str, driver_source ∈ str) → object:
    directory.joinpath("YoungTableaux").mkdir(parents=True)
    directory.joinpath("YoungTableaux", model_name + ".idric").write_text(module)
    driver ∈ object ← directory.joinpath(Path(driver_source).name)
    shutil.copyfile(ROOT.joinpath(driver_source), driver)
    driver_name ∈ str ← driver.name
    result ∈ object ← subprocess.run([idric, "-o", "transition-checks", driver_name],
                                    cwd=directory, text=True, capture_output=True, timeout=120)
    directory.joinpath("compile.stdout").write_text(result.stdout)
    directory.joinpath("compile.stderr").write_text(result.stderr)
    executable ∈ object ← directory.joinpath("build/exec/transition-checks")
    code ∈ int ← result.returncode
    exists ∈ bool ← executable.is_file()
    stdout ∈ str ← result.stdout
    stderr ∈ str ← result.stderr
    if code != 0 or not exists or "Error:" in stdout or "Error:" in stderr:
        raise SystemExit("FAIL: actual Idriç compilation; see " + str(directory))
    result = subprocess.run([environment, str(executable)], cwd=directory,
                            text=True, capture_output=True, timeout=30)
    directory.joinpath("execution.stdout").write_text(result.stdout)
    directory.joinpath("execution.stderr").write_text(result.stderr)
    return result

def main() → None:
    parser ∈ object ← argparse.ArgumentParser()
    parser.add_argument("--compiler", required=True)
    parser.add_argument("--idric", required=True)
    parser.add_argument("--idric-env", required=True)
    args ∈ object ← parser.parse_args()
    idric ∈ str ← args.idric
    environment ∈ str ← args.idric_env
    compiler ∈ str ← args.compiler
    output ∈ object ← ROOT.joinpath("build/typed-jeu-evidence")
    if output.exists():
        shutil.rmtree(output)
    output.mkdir(parents=True)
    legacy ∈ str ← ROOT.joinpath("types/YoungTableaux/JeuTrace.idric").read_text()
    result ∈ object ← compile_and_run(idric, environment, output.joinpath("legacy"),
        legacy, "JeuTrace", "examples/autogenerated/jeu-trace/JeuTraceChecks.idric")
    code ∈ int ← result.returncode
    observed ∈ str ← result.stdout
    if code != 0 or not ("JDT_IDRIC_HOST PASS: 13 typed decision/provenance checks" in observed):
        raise SystemExit("FAIL: retained Idriç decision/provenance rules")
    module ∈ str ← ROOT.joinpath("types/YoungTableaux/CheckedJeu.idric").read_text()
    result = compile_and_run(idric, environment, output.joinpath("actual"), module,
        "CheckedJeu", "examples/autogenerated/checked-jeu-transition/TransitionChecks.idric")
    code = result.returncode
    observed = result.stdout
    if code != 0 or "ADMISSION_FAILURE" in observed:
        raise SystemExit("FAIL: checked transitions execution")
    native ∈ object ← output.joinpath("native-observer")
    command ∈ list[str] ← [compiler, "-fno-link-libatomic", "-std=c17", "-O2",
        "-Wall", "-Wextra", "-Werror", "-Wpedantic", "-Wshadow",
        "-I" + str(ROOT.joinpath("app/core")), str(ROOT.joinpath("tests/typed_jeu_observer.c"))]
    core_paths ∈ list[object] ← sorted(ROOT.joinpath("app/core").glob("*.c"))
    for core in core_paths:
        command.append(str(core))
    command.extend(["-lm", "-o", str(native)])
    subprocess.run(command, check=True, timeout=120)
    result = subprocess.run([str(native)], text=True, capture_output=True, timeout=30)
    output.joinpath("native.stdout").write_text(result.stdout)
    output.joinpath("native.stderr").write_text(result.stderr)
    code = result.returncode
    expected ∈ str ← result.stdout
    cases ∈ int ← expected.count("CASE ")
    if code != 0 or cases != 18 or "UNEXPECTED_NATIVE" in expected or observed != expected:
        raise SystemExit("FAIL: executed Idriç/native traces differ")
    receipts ∈ list[str] ← ["case\tresult\n", "retained-13-rules\tPASS\n",
        "checked-18-traces-and-9-admission-controls\tPASS\n"]
    mutations ∈ list[tuple[str,str,str,str]] ← [
        ("tie-right", "if right_value < below_value", "if right_value <= below_value", "CASE equal-chooses-below"),
        ("cell-overflow", "value > 0 && value <= 64", "value > 0", "ADMISSION_FAILURE oversized-row"),
        ("ascending-partition", "next <= previous", "next <= 64", "ADMISSION_FAILURE ascending-shape"),
        ("entry-overflow", "entry.value > 0 && (the Integer (cast entry.value)) <= 2147483647", "entry.value > 0", "ADMISSION_FAILURE oversized-entry")]
    for mutation in mutations:
        name ∈ str ← mutation[0]
        old ∈ str ← mutation[1]
        new ∈ str ← mutation[2]
        diagnostic ∈ str ← mutation[3]
        occurrences ∈ int ← module.count(old)
        if occurrences != 1:
            raise SystemExit("FAIL: mutation is not unique: " + name)
        result = compile_and_run(idric, environment, output.joinpath(name), module.replace(old,new),
            "CheckedJeu", "examples/autogenerated/checked-jeu-transition/TransitionChecks.idric")
        code = result.returncode
        observed = result.stdout
        if name == "tie-right":
            if code != 0 or observed == expected or not (diagnostic in observed):
                raise SystemExit("FAIL: compiled tie mutant escaped")
        else:
            if code == 0 or not (diagnostic in observed):
                raise SystemExit("FAIL: compiled admission mutant escaped: " + name)
        receipts.append(name + "\tREJECTED\n")
    output.joinpath("receipt.tsv").write_text("".join(receipts))
    observation_digest ∈ str ← hashlib.sha256(expected.encode()).hexdigest()
    output.joinpath("observations.sha256").write_text(observation_digest + "\n")
    print("IDRIC_TRANSITIONS PASS: 18 native trace comparisons, 9 admission controls, 4 compiled mutants, 13 retained rules")

main()
